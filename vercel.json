{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "includeFiles": "{backend/**,models/*.json,models/*.npz,data/serve/**,frontend/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(css|js|assets)/(.*)",
      "dest": "api/index.py",
      "headers": { "Cache-Control": "public, max-age=3600" }
    },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
