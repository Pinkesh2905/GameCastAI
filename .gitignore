__pycache__/
*.pyc
.env
.venv/
venv/
.pytest_cache/

# Cricsheet source JSON: ~480 MB, and one command rebuilds it.
#   python -m backend.ml.download_data
data/raw/

# Training tables. Only needed to retrain, and regenerated by:
#   python -m backend.ml.build_dataset
data/processed/*_chase.parquet
data/processed/*_setting.parquet

# data/processed/*_matches.parquet and *_timeline.parquet ARE committed:
# the match browser and the ball-by-ball replay read them at request time,
# and together they are under 10 MB.

# Local editor and tooling config, including the dev-server launch profile,
# which points at a Windows virtualenv path.
.claude/

*.log
.DS_Store

.vercel
