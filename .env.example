# Copy to .env and fill in. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# On a hosting platform, set these as environment variables in its dashboard
# instead of uploading a file. Vercel: Project -> Settings -> Environment
# Variables. Render/Railway/Fly: the equivalent panel.

# Google Analytics 4 measurement id, from Admin -> Data streams -> your web
# stream. Looks like G-XXXXXXXXXX. Leave unset to keep analytics switched off
# entirely - no tag is loaded and no cookie is set.
GA_MEASUREMENT_ID=

# Canonical public URL, used for link previews. Optional, no trailing slash.
# SITE_URL=https://gamecast.example.com
